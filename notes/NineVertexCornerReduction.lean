def compactOne (i : Nat) :=
  let rows := hostAt hosts5 i
  let (optimized,pairs,book,n) := compactBooks[i]?.getD (false,[],0,0)
  decide (rows.length ≤ 32) &&
    (if optimized then
       pairs.all (fun p => checkPair rows p.1 p.2) &&
         (sparseTree (symRows (rootRows rows 0) (orbitSites pairs))
           (symRows (rootRows rows 1) (orbitSites pairs)) hints908 book 10 0
           (seedCells rows) (2^pairs.length-1) == some n)
     else rejectTree (profileList rows 10) book 10 0 (seedCells rows) == some n)

def allCompact := (List.range hosts5.size).all compactOne

theorem compact_sound (i : Nat) (h : compactOne i = true) :
    ¬ fitsRows (hostAt hosts5 i).toFinset := by
  generalize hd : compactBooks[i]?.getD (false, [], 0, 0) = d
  unfold compactOne at h
  rw [hd] at h
  rcases d with ⟨b,pairs,book,n⟩
  cases b with
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    exact terminal_reject _ h.1 book n h.2
  | true =>
    simp only [↓reduceIte, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    exact sparse_reject _ h.1 pairs hints908 book n h.2.1 h.2.2

theorem six_of_compact (replayed : allCompact = true) (C : AndCountCircuit 9) (ok : correct C) :
    6 ≤ C.size := by
  by_contra low
  obtain ⟨i,hi,fit⟩ := classified5 (circuit_realizable C (by omega) ok)
  exact compact_sound i (List.all_eq_true.mp replayed i (List.mem_range.mpr hi)) fit

