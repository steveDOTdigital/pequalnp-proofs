/-- The cut inputs are compared by r. The two auxiliary predicates represent
the monotone prefix before the NOT and the monotone suffix after it. -/
def OneInversion {α : Type} (r : α → α → Prop) (f : α → Prop) : Prop :=
  ∃ (h : α → Prop) (k : α → Prop → Prop),
    (∀ x y, r x y → h x → h y) ∧
    (∀ x y (s t : Prop), r x y → (s → t) → k x s → k y t) ∧
    ∀ x, f x ↔ k x (¬ h x)

def NoTwoDrops {α : Type} (r : α → α → Prop) (f : α → Prop) : Prop :=
  ∀ p i q j, f p → ¬ f i → f q → ¬ f j → r p i → r i q → r q j → False

theorem noTwoDrops_of_circuit {α : Type} {r : α → α → Prop} {f : α → Prop}
    (circuit : OneInversion r f) : NoTwoDrops r f := by
  obtain ⟨h,k,hm,km,correct⟩ := circuit
  have drop (p i : α) (on : f p) (off : ¬ f i) (pi : r p i) :
      ¬ ((¬ h p) → (¬ h i)) := by
    intro ordered
    exact off ((correct i).mpr (km p i _ _ pi ordered ((correct p).mp on)))
  intro p i q j fp fi fq fj pi iq qj
  have hi : h i := Classical.byContradiction (fun hn => drop p i fp fi pi (fun _ => hn))
  exact drop q j fq fj qj (fun hn => False.elim (hn (hm i q iq hi)))

theorem oneInversion_iff {α : Type} (r : α → α → Prop) (f : α → Prop)
    (refl : ∀ x, r x x) (trans : ∀ x y z, r x y → r y z → r x z) :
    OneInversion r f ↔ NoTwoDrops r f := by
  constructor
  · exact noTwoDrops_of_circuit
  · intro nodrops
    let h : α → Prop := fun x => ∃ i p, ¬ f i ∧ f p ∧ r p i ∧ r i x
    let k : α → Prop → Prop := fun x t => ∃ p, f p ∧ r p x ∧ ((¬ h p) → t)
    refine ⟨h,k,?_,?_,?_⟩
    · intro x y xy hx
      obtain ⟨i,p,fi,fp,pi,ix⟩ := hx
      exact ⟨i,p,fi,fp,pi,trans i x y ix xy⟩
    · intro x y s t xy st ks
      obtain ⟨p,fp,px,go⟩ := ks
      exact ⟨p,fp,trans p x y px xy,fun u => st (go u)⟩
    · intro x
      constructor
      · intro fx
        exact ⟨x,fx,refl x,fun u => u⟩
      · intro out
        obtain ⟨p,fp,px,ordered⟩ := out
        apply Classical.byContradiction
        intro off
        have hx : h x := ⟨x,p,off,fp,px,refl x⟩
        have low : ¬ h p := by
          intro hp
          obtain ⟨i,u,fi,fu,ui,ip⟩ := hp
          exact nodrops u i p x fu fi fp off ui ip px
        exact ordered low hx

/-- The decimal edge labels are 10 times the first vertex plus the second. -/
def petersen (x : Nat) : Prop :=
  ([1,12,23,34,40,5,16,27,38,49,57,79,96,68,85] : List Nat).any
    (fun e => x.testBit (e / 10) && x.testBit (e % 10)) = true

/-- Keep the visible bits and append AND/OR outputs for the two hidden coordinates. -/
def exampleFeatures (x : Nat) : Nat :=
  let a := x.testBit 0
  let b := x.testBit 3
  let u := x.testBit 1 || x.testBit 2
  let v := x.testBit 1 || x.testBit 4
  (x &&& 1014) + (if a && u then 1024 else 0) + (if a || u then 2048 else 0) +
    (if b && v then 4096 else 0) + (if b || v then 8192 else 0)

def exampleOrder (x y : Nat) : Prop :=
  exampleFeatures x &&& exampleFeatures y = exampleFeatures x

theorem exampleRequiresTwo : ¬ OneInversion exampleOrder petersen := by
  intro circuit
  apply noTwoDrops_of_circuit circuit 33 36 44 52
  all_goals first | (unfold petersen; decide) | (unfold exampleOrder; decide)

private def coordinate (cut pos : Nat) := (cut >>> (4*pos)) % 16

def cutFeatures (cut x : Nat) : Nat :=
  let a := coordinate cut 0
  let b := coordinate cut 3
  let u := x.testBit (coordinate cut 1) || x.testBit (coordinate cut 2)
  let v := x.testBit (coordinate cut 4) || x.testBit (coordinate cut 5)
  let visible := x &&& (1023 ^^^ ((1 <<< a) ||| (1 <<< b)))
  visible + (if x.testBit a && u then 1024 else 0) + (if x.testBit a || u then 2048 else 0) +
    (if x.testBit b && v then 4096 else 0) + (if x.testBit b || v then 8192 else 0)

def cutOrder (c x y : Nat) : Prop := cutFeatures c x &&& cutFeatures c y = cutFeatures c x

private def rowAt (w i : Nat) := (w >>> (10*i)) % 1024

def Witness (c w : Nat) : Prop :=
  let p := rowAt w 0
  let i := rowAt w 1
  let q := rowAt w 2
  let j := rowAt w 3
  petersen p ∧ ¬ petersen i ∧ petersen q ∧ ¬ petersen j ∧
    cutOrder c p i ∧ cutOrder c i q ∧ cutOrder c q j

private instance (c w : Nat) : Decidable (Witness c w) := by
  unfold Witness petersen cutOrder
  infer_instance

theorem witness_excludes {c w : Nat} (hw : Witness c w) : ¬ OneInversion (cutOrder c) petersen := by
  intro circuit
  obtain ⟨fp,fi,fq,fj,pi,iq,qj⟩ := hw
  exact noTwoDrops_of_circuit circuit _ _ _ _ fp fi fq fj pi iq qj

